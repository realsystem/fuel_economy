{
  "name": "fuel-photo-log",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-based fuel pump photo reader. All processing happens locally in the browser.",
  "type": "module",
  "scripts": {
    "dev": "node build.mjs --serve",
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
